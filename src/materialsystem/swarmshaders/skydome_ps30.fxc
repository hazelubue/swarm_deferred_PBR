/******************************************************************************/

//uniformly distributed, normalized rand, [0, 1)
float nrand(in float2 n)
{
    return frac(sin(dot(n.xy, float2(12.9898, 78.233))) * 43758.5453);
}

float n4rand_ss(in float2 n)
{
    float nrnd0 = nrand(n + 0.07 * frac(g_parameters.w));
    float nrnd1 = nrand(n + 0.11 * frac(g_parameters.w + 0.573953));
    return 0.23 * sqrt(-log(nrnd0 + 0.00001)) * cos(2.0 * 3.141592 * nrnd1) + 0.5;
}

float toLinear(float _rgb)
{
    return pow(abs(_rgb), 2.2);
}

float3 Perez(float3 A, float3 B, float3 C, float3 D, float3 E, float costeta, float cosgamma)
{
    float _1_costeta = 1.0 / costeta;
    float cos2gamma = cosgamma * cosgamma;
    float gamma = acos(cosgamma);
    float3 f = float3(1.0f.xxx + A * exp(B * _1_costeta)) * float3(1.0f.xxx + C * exp(D * gamma) + E * cos2gamma);
    return f;
}

float3 convertRGB2XYZ(float3 _rgb)
{
	// Reference(s):
	// - RGB/XYZ Matrices
	//   https://web.archive.org/web/20191027010220/http://www.brucelindbloom.com/index.html?Eqn_RGB_XYZ_Matrix.html
    float3 xyz;
    xyz.x = dot(float3(0.4124564, 0.3575761, 0.1804375), _rgb);
    xyz.y = dot(float3(0.2126729, 0.7151522, 0.0721750), _rgb);
    xyz.z = dot(float3(0.0193339, 0.1191920, 0.9503041), _rgb);
    return xyz;
}

float3 convertXYZ2RGB(float3 _xyz)
{
    float3 rgb;
    rgb.x = dot(float3(3.2404542, -1.5371385, -0.4985314), _xyz);
    rgb.y = dot(float3(-0.9692660, 1.8760108, 0.0415560), _xyz);
    rgb.z = dot(float3(0.0556434, -0.2040259, 1.0572252), _xyz);
    return rgb;
}

float hash_iq(float n)
{
    return frac(sin(n) * 753.5453123);
}

float noise_iq3(float3 x)
{
    float3 p = floor(x), f = frac(x);
    f = f * f * (3.0 - 2.0 * f);
    float n = p.x + p.y * 157.0 + 113.0 * p.z;

    return lerp(
        lerp(lerp(hash_iq(n), hash_iq(n + 1.0), f.x),
             lerp(hash_iq(n + 157), hash_iq(n + 158), f.x), f.y),
        lerp(lerp(hash_iq(n + 113), hash_iq(n + 114), f.x),
             lerp(hash_iq(n + 270), hash_iq(n + 271), f.x), f.y),
        f.z
    );
}

float3 renderStars(float3 dir)
{
    float n = noise_iq3(dir * 500.0 + g_Time * 0.05); // twinkle
    float bright = pow(saturate(n), 50.0);

    // Fade near horizon
    float horizonFade = smoothstep(0.0, 0.2, dir.y);

    return bright * float3(1.0, 1.0, 1.0);
}

float3 rotateAroundAxis(float3 Vector, float3 axis, float angle)
{
    // Rodrigues' rotation formula
    float cosA = cos(angle);
    float sinA = sin(angle);
    
    return 
    Vector* cosA
    +cross(axis, Vector) * sinA + axis * dot(axis, Vector) * (1 - cosA);
}

struct CloudParams
{
    float2 l0_coverage;
    float l0_cumulus_stratus_blend;
    float l0_altitude_scale;
    float2 l0_detail_weights;
    float2 l0_edge_sharpening;
    float l0_scattering_coeff;
    float l0_extinction_coeff;
    float l0_shadow;
    float cumulus_congestus_blend;
};


#include "clouds/utility/phase_functions.h"
#include "clouds/constants.h"
#include "clouds/atmosphere/atmosphere.h"
#include "clouds/common.h"
//#include "clouds/parameters.h"
#include "clouds/cirrus.h"
#include "clouds/noctilucent.h"
#include "clouds/cumulus_congestus.h"
#include "clouds/compositeClouds.h"


struct PS_INPUT
{
    float3 worldPos : POSITION1;
    float3 projPos : POSITION2;
    float3 modelPos : POSITION3;
};

struct PS_OUTPUT
{
    float4 vColor_0 : COLOR0;
    float4 vColor_1 : COLOR1;
    float4 vColor_2 : COLOR2;
};

PS_OUTPUT main(PS_INPUT i)
{
    PS_OUTPUT o;
        
    // Perez coefficients.
    float3 A = g_perezCoeff[0].xyz;
    float3 B = g_perezCoeff[1].xyz;
    float3 C = g_perezCoeff[2].xyz;
    float3 D = g_perezCoeff[3].xyz;
    float3 E = g_perezCoeff[4].xyz;

    float3 direction = normalize(i.modelPos.xyz);
    float3 rayDir = normalize(float3(i.modelPos.x, i.modelPos.z, i.modelPos.y));
   // float3 rayDir = normalize(float3(i.modelPos.x, i.modelPos.y, i.modelPos.z));
    float3 lightDir = normalize(g_SunPos.xyz);
    float rotationAngle = g_Time;
    
    float3 rotatedPos = rotateAroundAxis(rayDir, lightDir, lightDir.z);
    
    //float3 rotatingPos = cross(lightDir, rayDir);

    float3 skyDir = float3(0.0, 0.0, 1.0);
    float costeta = max(dot(direction, skyDir), 0.001);
    float cosgamma = clamp(dot(direction, lightDir.xyz), -0.9999, 0.9999);
    float cosgammas = dot(skyDir, lightDir.xyz);

    float3 P = Perez(A, B, C, D, E, costeta, cosgamma);
    float3 P0 = Perez(A, B, C, D, E, 1.0, cosgammas);

    float3 skyColorxyY = float3(
		  g_SkyLum.x / (g_SkyLum.x + g_SkyLum.y + g_SkyLum.z)
		, g_SkyLum.y / (g_SkyLum.x + g_SkyLum.y + g_SkyLum.z)
		, g_SkyLum.y
		);
    
    float3 Yp = skyColorxyY * P / P0;
    float3 skyColor = float3(Yp.x * Yp.z / Yp.y, Yp.z, (1.0 - Yp.x - Yp.y) * Yp.z / Yp.y);
    skyColor = convertXYZ2RGB(skyColor * g_parameters.z);
    
    float size2 = g_parameters.x * g_parameters.x;

    float dist = 2.0 * (1.0 - dot(direction, lightDir));
    float sun = exp(-dist / g_parameters.y / size2) + step(dist, size2);
    float sun2 = min(sun * sun, 1.0);
    
    float3 sunColor = g_SunColor;
    float3 coloredSun = sun2 * sunColor;
    
    float3 starColor = renderStars(rotatedPos);
    float dither = n4rand_ss(i.projPos.xy); 
    
 
    float cloudLinearDepth = 0.0;
    
    //float3 clouds_topLayer = GetVolumetricClouds(10.0, 1000.0, cloudLinearDepth, 1.0, 1.0, (float3) 0, rayDir, 1000.0, dot(rayDir, SUN_DIR), rayDir.y, n4rand_ss(i.projPos.xy), lerp(skyColor, coloredSun, starColor), noisetex, 1).rgb;
    //float3 clouds_bottomLayer = GetVolumetricClouds(5.0, 1000.0, cloudLinearDepth, 1.0, 1.0, (float3) 0, rayDir, 1000.0, dot(rayDir, SUN_DIR), rayDir.y, n4rand_ss(i.projPos.xy), lerp(skyColor, coloredSun, starColor), noisetex, 0).rgb;

    float3 clear_sky = skyColor + coloredSun;
    
    float distance_to_terrain = -1.0;
    float3 air_viewer_pos = float3(g_cameraPos.x, planet_radius + g_cameraPos.y, g_cameraPos.z);
    
    cameraPosition = g_cameraPos;
    world_age = g_Time;
    float3 sun_dir = normalize(g_SunPos.xyz);
    //moon_dir = normalize(g_SunPos.xyz);
    //sun_color = sunColor;
    //moon_color = sunColor;
    //sky_color = skyColor;
    //sunlight_color = sunColor;

    CloudsResult result = draw_clouds(
    air_viewer_pos,
    rayDir,
    sun_dir,
    sunColor,
    clear_sky,
    distance_to_terrain,
    dither);

    float3 clouds_color = result.scattering.rgb; // Cloud color contribution
    float cloud_transmittance = result.transmittance; // Transmittance value
    //float distance = cirrus_result.distance_to_sphere; // Distance to cloud
    
    float3 final_color = clear_sky + clouds_color * (1.0 - cloud_transmittance);
    
#if !STARFIELD_ENABLED
    float3 color = final_color;
#else
    float3 color = final_color + starColor;
#endif
    
    o.vColor_0 = float4(color.rgb, 1.0);
    o.vColor_1 = float4(normalize(float3(i.modelPos.xyz)) * -1.0f, 1.0);
    o.vColor_2 = float4(0.0f.xxx, 0.0);
    return o;
}
